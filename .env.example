# zentao-legacy-mcp environment configuration (copy to ~/.local/share/zentao-legacy-mcp/env, chmod 600)
# or export these in the client's environment. Real env vars always override the file.

# --- required ---
# Your ZenTao deployment URL (no trailing slash)
ZENTAO_BASE_URL=https://zentao.example.com
# Your ZenTao login account and password (stored ONLY locally, never sent to any third party)
ZENTAO_ACCOUNT=your_account
ZENTAO_PASSWORD=your_password

# --- optional ---
# Keep the session alive across process restarts (default 1)
ZENTAO_KEEP_LOGIN=1
# Master switch for machine markers on created entities (development environments only!)
# 0 = delivered mode: created entities are REAL data with no markers (default)
# 1 = development mode: [MCP] title prefix + MCP-AUTO keywords + color + via-notes,
#     so test entities are filterable/cleanable via zentao_cleanup_mcp
ZENTAO_MARKERS=0
# Operator name shown in marker tokens / builder field (default: the account)
#ZENTAO_OPERATOR=
# Custom env file location (default ~/.local/share/zentao-legacy-mcp/env)
#ZENTAO_ENV_FILE=
# Deployment profile cache location (default: next to the env file, profile.json)
#ZENTAO_PROFILE_FILE=
# Deployment profile cache TTL in hours (default 24). 0 disables caching.
#ZENTAO_PROFILE_TTL_HOURS=24
# URL style: PATH_INFO (default) or GET
#ZENTAO_REQUEST_TYPE=PATH_INFO
# Per-request network timeout in ms (default 30000)
#ZENTAO_REQUEST_TIMEOUT_MS=30000
# Debug logging to stderr (default 0)
#ZENTAO_DEBUG=0
